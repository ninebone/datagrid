{
  "name": "@ninebone/util",
  "version": "1.0.58",
  "description": "Custom Element based Util Component for Real-time Collaboration",
  "type": "module",
  "main": "./dist/nine-util.umd.cjs",
  "module": "./dist/nine-util.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nine-util.js",
      "require": "./dist/nine-util.umd.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "devDependencies": {
    "terser": "^5.46.1",
    "typescript": "^5.0.0",
    "vite": "^6.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "webelements",
    "collaboration"
  ],
  "author": "nine-lab",
  "license": "MIT",
  "dependencies": {
    "dayjs": "^1.11.21",
    "livekit-client": "^2.18.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "watch": "vite build --watch",
    "prepublishOnly": "npm run build",
    "release": "npm version patch && npm run build && npm publish --access public"
  }
}
