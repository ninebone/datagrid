{
  "name": "@ninebone/datagrid",
  "version": "0.5.2",
  "description": "Blazing-fast virtualized HTML table for massive datasets with inline editing",
  "keywords": [
    "ninebone",
    "datagrid",
    "table",
    "nine-table"
  ],
  "homepage": "https://ninebone.github.io/datagrid",
  "bugs": {
    "url": "https://github.com/ninebone/datagrid/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ninebone/datagrid.git"
  },
  "author": {
    "name": "ninebone",
    "email": "nandoo@hanmail.net"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/nine-table.umd.js",
  "module": "./dist/nine-table.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nine-table.js",
      "require": "./dist/nine-table.umd.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build:css": "node scripts/bundle-css.js",
    "build:core": "vite build && npm run build:css",
    "build:example": "cd example/react && npm install && npm run build",
    "build:docs": "npm run build:core && npm run build:example && rm -rf docs/* && cp -r example/react/dist/* docs/ && cp docs/index.html docs/404.html && git add docs/",
    "build": "npm run build:core",
    "watch": "vite build --watch",
    "version": "npm run build",
    "release": "npm version patch && npm publish --access public"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "exceljs": "^4.4.0"
  },
  "peerDependenciesMeta": {
    "exceljs": {
      "optional": true
    }
  },
  "dependencies": {
    "@ninebone/core": "^0.0.3"
  }
}
