{
  "name": "@ninebone/datagrid",
  "version": "0.0.19",
  "description": "Blazing-fast virtualized HTML table for massive datasets with inline editing",
  "keywords": [
    "datagrid",
    "data-grid",
    "datatable",
    "data-table",
    "table",
    "grid",
    "web-components",
    "react",
    "virtual-scroll"
  ],
  "homepage": "https://ninebone.github.io/datagrid",
  "bugs": {
    "url": "https://github.com/ninebone/datagrid/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ninebone/datagrid.git"
  },
  "author": {
    "name": "ninebone",
    "email": "nandoo@hanmail.net"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/nine-table.umd.js",
  "module": "./dist/nine-table.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nine-table.js",
      "require": "./dist/nine-table.umd.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "workspaces": [
    "example/react"
  ],
  "scripts": {
    "dev": "vite",
    "build:css": "node scripts/bundle-css.js",
    "build:core": "vite build && npm run build:css",
    "build:example": "npx --prefix example/react vite build",
    "build": "npm run build:core && npm run build:example",
    "watch": "vite build --watch",
    "version": "npm run build",
    "release": "npm version patch && npm publish --access public"
  },
  "peerDependencies": {
    "@ninebone/util": "*"
  },
  "devDependencies": {
    "vite": "^8.3.5"
  }
}
